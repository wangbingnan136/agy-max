{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "env": {
    "AGY_MAX_VERSION": "1.4.3",
    "NODE_USE_ENV_PROXY": "1"
  },
  "restart_policy": "always",
  "display_name": "Antigravity Max",
  "description": "All-in-one flagship workbench, Codex workflow, Prism optics, context telemetry, and usage dashboard for Antigravity 2.0.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Antigravity Max",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Antigravity Max"
      }
    ]
  }
}
